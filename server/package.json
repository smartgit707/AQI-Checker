{
  "name": "aerosense-server",
  "version": "1.0.0",
  "description": "Backend foundation and REST API service for AeroSense Environmental Intelligence Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "db:init": "node -e \"import('./src/config/db.js').then(m => m.connectDB()).then(() => process.exit(0)).catch(() => process.exit(1))\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.24.5"
  }
}
