PORT=5050
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=aerosense
DB_CONNECTION_LIMIT=10

# Optional: Full MySQL Connection URL (alternative to separate DB_* variables)
# DATABASE_URL=mysql://your_mysql_username:your_mysql_password@localhost:3306/aerosense

# Security & Session
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
